
@import "tailwindcss";

:root {
  --background: #090b12;
  --surface: #111521;
  --surface-hover: #191f2e;
  --border: #242b3b;
  --foreground: #f1f3fa;
  --muted: #8b93a7;
  --primary: #8b5cf6;
  --primary-light: #a78bfa;
  --accent: #3b82f6;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 260px;
  min-height: 100vh;
  padding: 26px 18px;
  background: #0d111c;
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 48px;
}

.brand-icon,
.stat-icon {
  display: grid;
  place-items: center;
  color: var(--primary-light);
  background: rgba(139, 92, 246, .13);
  border-radius: 12px;
  width: 42px;
  height: 42px;
}

.brand strong,
.user-profile strong {
  display: block;
  font-size: 15px;
}

.brand small,
.user-profile small {
  display: block;
  color: var(--muted);
  font-size: 11px;
  margin-top: 4px;
}

.nav-caption,
.eyebrow {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 1.5px;
  font-weight: 700;
}

.navigation {
  display: grid;
  gap: 7px;
  margin-top: 16px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 12px;
  border-radius: 9px;
  color: var(--muted);
  font-size: 13px;
  transition: .2s;
}

.nav-link:hover,
.nav-link.active {
  background: rgba(139, 92, 246, .13);
  color: var(--primary-light);
}

.sidebar-bottom {
  margin-top: auto;
}

.user-profile {
  display: flex;
  gap: 12px;
  align-items: center;
  border-top: 1px solid var(--border);
  margin-top: 20px;
  padding: 20px 4px 0;
}

.avatar {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  background: #39266a;
  border-radius: 50%;
}

.main-area {
  flex: 1;
  min-width: 0;
}

.topbar {
  height: 76px;
  border-bottom: 1px solid var(--border);
  padding: 0 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.breadcrumb {
  color: var(--muted);
  font-size: 13px;
}

.breadcrumb span {
  margin: 0 10px;
}

.topbar-actions {
  display: flex;
  gap: 12px;
}

.icon-button {
  display: grid;
  place-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--muted);
  border-radius: 10px;
  width: 40px;
  height: 40px;
}

.mobile-menu {
  display: none;
}

.page-content {
  padding: 34px;
  max-width: 1600px;
  margin: auto;
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 32px;
}

.page-heading h1 {
  font-size: 28px;
  margin: 10px 0;
}

.page-heading p,
.panel p {
  color: var(--muted);
  font-size: 13px;
}

.status-indicator {
  color: #4ade80;
  background: rgba(74, 222, 128, .09);
  padding: 10px 14px;
  border-radius: 20px;
  font-size: 11px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.stat-card,
.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 22px;
}

.stat-card p {
  color: var(--muted);
  font-size: 12px;
  margin: 17px 0 8px;
}

.stat-card h2 {
  font-size: 24px;
  margin: 0;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 18px;
  margin-top: 22px;
}

.panel {
  min-height: 170px;
}

.panel h2 {
  font-size: 15px;
}

@media (max-width: 1000px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .sidebar {
    display: none;
  }

  .mobile-menu {
    display: grid;
  }

  .topbar {
    padding: 0 16px;
  }

  .page-content {
    padding: 22px 16px;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .stats-grid {
    gap: 10px;
  }

  .stat-card {
    padding: 15px;
  }
}
